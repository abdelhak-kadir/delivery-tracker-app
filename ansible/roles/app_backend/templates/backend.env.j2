# Backend Environment Configuration
# Variable names are the ones the Spring Boot app reads (see back/src/main/resources/application*.y*ml).
SPRING_PROFILES_ACTIVE=docker
SERVER_PORT={{ app.port }}

# Database (DigitalOcean managed PostgreSQL requires TLS)
SPRING_DATASOURCE_URL=jdbc:postgresql://{{ database.host }}:{{ database.port }}/{{ database.name }}?sslmode=require
SPRING_DATASOURCE_USERNAME={{ database.username }}
SPRING_DATASOURCE_PASSWORD={{ database.password }}
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE={{ database.pool_size | default(10) }}
# The docker profile does not set ddl-auto and there is no migration tool: let Hibernate manage the schema
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Application user and JWT
APP_USER_USERNAME={{ app_config.app_user_username }}
APP_USER_PASSWORD={{ app_config.app_user_password }}
JWT_SECRET={{ app_config.jwt_secret }}

# CORS (comma-separated, read as app.cors.allowed-origins)
APP_CORS_ALLOWED_ORIGINS={{ app_config.cors_origins | join(',') }}
