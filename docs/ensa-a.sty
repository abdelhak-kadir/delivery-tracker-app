\newcommand{\pagedegarde}[5]{
\pagestyle{empty}
\begin{tikzpicture}[remember picture, overlay]
\path 
(current page.north west) coordinate (A) 
(current page.north east) coordinate (B)
(current page.south east) coordinate (C)
(current page.south west) coordinate (D)
(current page.center) coordinate (E);
\node[opacity=0.12] at (E) {\includegraphics[scale=0.2]{IbnZohr.png}};
\node at ([yshift=12cm]E) {\includegraphics[scale=0.55]{Logo.png}};
\node at ([yshift=9.5cm, xshift=6.5cm]E) {\textbf{#1}};
\node[scale=2.25] at ([yshift=7.25cm]E) {\textbf{Final Year Project Report #2:}};
\node[scale=1.75] at ([yshift=5.5cm]E) {\textbf{Presented by:}};
\node[scale=1.25] at ([yshift=4.5cm]E) {\textbf{#3}};
\node[scale=1.25] at ([yshift=3.75cm]E) {\textbf{#4}};
\node[scale=1.75] at ([yshift=2.25cm]E) {\textbf{Major:} #5};
\end{tikzpicture}
\vspace{12cm}
\suitepagedegarde
}
\newcommand{\suitepagedegarde}[8]{
\vspace{0.75cm}
\begin{center}
\begin{tikzpicture}[overlay]
\node[text width=12cm, align=center, scale=1.725]  (E) {\sc #1};
\draw[line width=1.25mm, Eblue] ([yshift=0.5cm, xshift=-8.75cm]E.north)--([yshift=0.5cm, xshift=8.75cm]E.north);
\draw[line width=1.25mm, Eblue] ([xshift=-8.75cm, yshift=-0.5cm]E.south)--([yshift=-0.5cm, xshift=8.75cm]E.south);
\end{tikzpicture}
\end{center}
\vspace{3cm}
\begin{minipage}[t]{0.6\linewidth}
\raggedright
\textbf{\scalebox{1.85}{Supervised by:}}\\[0.5cm]
\large \textbf{#3} Latifa Makhlouf
\end{minipage}
\begin{minipage}[t]{0.4\linewidth}
\begin{center}
\textbf{\scalebox{1.75}{Company:}}\\[0.25cm]
\includegraphics[scale=#5]{#4}
\end{center}
\end{minipage}
\vspace{0.75cm}
\begin{minipage}[C]{0.6\linewidth}
\phantom{Spacing to align with the names on the right}
\end{minipage}
\begin{minipage}[C]{0.4\linewidth}
\textbf{#2}\\[0.15cm]
\textbf{#6}\\[0.15cm]
\textbf{#7}
\end{minipage}
}


\renewcommand\thechapter{\arabic{chapter}}
\renewcommand\thesection{\arabic{section}}

\titleformat{name=\chapter,numberless}[display]
{\bfseries\Huge}
{}
{0pt}
{
\vspace*{-2.75cm}
\begin{tikzpicture}[]
\fill[Ecyan] (1,-0.5)rectangle(18,0.5)node[pos=0.115] (pos2){} node[pos=0.5] (pos) {};
\node[Eblue] at (pos) {\colorbox{white}{\scalebox{1.35}{\ #1\ }}};
\end{tikzpicture}}

\titleformat{\chapter}[display]
{\bfseries\Huge}
{}
{0pt}
{
\begin{tikzpicture}[remember picture, overlay]
\draw[Eblue, line width=0.5mm] ([xshift=-2.5cm]current page.north east)--([xshift=-2.5cm, yshift=-5cm]current page.north east);
\node[scale=1.5, Ecyan, opacity=0.75] at ([xshift=-1.5cm, yshift=-3cm]current page.north east) {\thechapter};
\node[anchor=south east, Ecyan, text width=16cm] at ([xshift=-2.5cm, yshift=-4.5cm]current page.north east) {#1};
\end{tikzpicture}
\vspace*{-1.85cm}
}

\titleformat{\section}[display]
{\bfseries\LARGE}
{}
{0pt}
{\vspace*{-1cm}
\begin{tikzpicture}
\fill[Ecyan] (-0.5,-0.5)rectangle(.5,.5) node[midway, Eblue] {\thesection};
\node[anchor=west, Ecyan] at (0.75,0) {#1}; 
\end{tikzpicture}
}

\titleformat{\subsection}[display]
{\bfseries\Large}
{}
{0pt}
{\vspace*{-.75cm}
\textbf{\textcolor{Eblue}{\thesubsection}\ \color{Eblue}#1}
}

\renewcommand{\sectionmark}[1]{\markright{\bfseries\color{Ecyan} #1}}
\renewcommand{\chaptermark}[1]{\markboth{\if@mainmatter\ \fi\bfseries\color{Ecyan}#1}{}}

\newcommand{\Newpage}{\newpage
\AddToShipoutPicture{
\begin{tikzpicture}[remember picture, overlay]
\path 
(current page.north west) coordinate (A) 
(current page.north east) coordinate (B)
(current page.south east) coordinate (C)
(current page.south west) coordinate (D)
(current page.center) coordinate (E);
\ifodd\thepage
\draw[line width=0.5mm, Eblue] ([xshift=1cm, yshift=1.25cm]D) node[below=7.5, black] (Node) {}--([xshift=-3cm, yshift=1.25cm]C);
\node[anchor=west, scale=1.15] at ([yshift=-0.1cm]Node) {\leftmark};
\node[anchor=west, scale=1.15, Ecyan] at ([xshift=18cm]Node) {\textbf{\thepage}};
\else
\draw[line width=0.65mm, Eblue] ([xshift=3cm, yshift=1.25cm]D)--([xshift=-1cm, yshift=1.25cm]C) node[below=7.5, black] (Node) {};
\node[anchor=east, scale=1.15, Ecyan] at ([xshift=-18cm]Node) {\textbf{\thepage}};
\node[anchor=east, scale=1.15] at ([yshift=-0.1cm]Node) {\rightmark};
\fi
\end{tikzpicture}
}}

